{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finite safety model",
  "description": "ModelChecker input. The kernel additionally checks finite-domain membership, variable references, unique IDs, expression types and depth <=32. Model safety never establishes implementation conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initial",
    "domains",
    "transitions",
    "invariants"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "initial": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "$ref": "#/$defs/scalar"
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "set"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@/-]{0,119}$"
          },
          "when": {
            "$ref": "#/$defs/expression"
          },
          "set": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/expression"
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "predicate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@/-]{0,119}$"
          },
          "predicate": {
            "$ref": "#/$defs/expression"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "maxStates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "default": 20000
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 100
    },
    "terminal": {
      "$ref": "#/$defs/expression"
    },
    "deadlockIsViolation": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "var"
          ],
          "properties": {
            "var": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge",
                "add",
                "sub"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    }
  }
}
