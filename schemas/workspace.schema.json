{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assurance workspace scanner configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace",
    "components"
  ],
  "properties": {
    "workspace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@/-]{0,119}$"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,49}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1
          },
          "tsconfig": {
            "type": "string"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "match",
                "mayImport"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "match": {
                  "type": "string"
                },
                "mayImport": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "maxFiles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          },
          "maxFileBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000000
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "javaClasspath": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "javaCoreClassPath": {
            "type": "string"
          }
        }
      }
    }
  }
}
