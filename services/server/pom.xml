<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion><parent><groupId>dev.assurance</groupId><artifactId>assurance-memory</artifactId><version>1.0.0</version><relativePath>../../pom.xml</relativePath></parent>
<artifactId>assurance-server</artifactId>
<dependencies>
<dependency><groupId>dev.assurance</groupId><artifactId>assurance-core</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
<dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
</dependencies>
<build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version><executions><execution><goals><goal>repackage</goal></goals></execution></executions></plugin></plugins></build>
<profiles><profile><id>postgres-it</id><build><plugins><plugin>
<groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
<executions><execution><id>postgres-verification</id><phase>integration-test</phase><goals><goal>java</goal></goals>
<configuration><mainClass>dev.assurance.core.JdbcStoreSelfTest</mainClass><classpathScope>test</classpathScope></configuration>
</execution></executions></plugin></plugins></build></profile></profiles>
</project>
